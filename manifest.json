{
    "name": "Color Season Finder: Style & Shopping Assistant",
    "version": "1.1.0",
    "description": "Eyedrop any color on your screen and get its seasonal color match and hex code — shop smarter, design better, style with confidence",
    "permissions": ["storage"],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "manifest_version": 3,
    "author": "Chris Yankah",
    "content_scripts": [
        {
            "matches": ["https://extensionpay.com/*"],
            "js": ["ExtPay.js"],
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_popup": "index.html",
        "default_title": "Color Season Finder"
    }
}
