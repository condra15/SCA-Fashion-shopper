{
    "name": "Color Analysis: Seasonal Fashion and Color Design Shopper",
    "version": "1.0.0",
    "description": "This extension uses a full screen eyedropper to find the color season and code of any item on screen using seasonal color analysis",
    "permissions": ["storage"],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "manifest_version": 3,
    "author": "Chris Yankah",
    "content_scripts": [
        {
            "matches": ["https://extensionpay.com/*"],
            "js": ["ExtPay.js"],
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_popup": "index.html",
        "default_title": "Seasonal Color Shopper"
    }
}
